# Copy to .env.local before running the local integration harness.
# This file contains integration-only, non-production values. Do not commit it.

# A locally running PostgreSQL is supported directly. Docker Compose is optional.
INTEGRATION_POSTGRES_HOST=localhost
INTEGRATION_POSTGRES_PORT=5433
POSTGRES_DB=refinvest_integration
POSTGRES_USER=refinvest
POSTGRES_PASSWORD=change-me-local-only
INTEGRATION_CORE_PORT=8080
INTEGRATION_COMPUTE_PORT=8000
INTEGRATION_WEB_PORT=3001
INTEGRATION_MEMBER_ID=900000000000001

# Core integration profile. The JWT secret must be at least 32 characters and
# must never be reused outside the local integration environment.
REFINVEST_JWT_ISSUER=https://integration.refinvest.local
REFINVEST_JWT_AUDIENCE=refinvest-integration
REFINVEST_JWT_SECRET=replace-with-a-local-32-character-test-secret
REFINVEST_WEB_ORIGIN=http://localhost:3001
REFINVEST_COOKIE_SECURE=false
REFINVEST_COOKIE_SAME_SITE=Lax

# Keep the browser and Core on localhost during cookie-based local testing.
# `localhost` and `127.0.0.1` are different sites for SameSite cookies.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional manual OAuth browser acceptance. Leave disabled for the API smoke.
# OAuth secrets belong only in .env.local; never commit them.
REFINVEST_OAUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=

# Shared only between the local Core and Compute processes.
# Core's COMPUTE_API_KEY is derived from this value by the integration scripts.
REFINVEST_INTERNAL_API_KEY=replace-with-a-local-internal-api-key
REFINVEST_COMPUTE_ENABLED=true

# Compute fixture artifact storage, relative to this integration workspace.
REFINVEST_SNAPSHOT_STORAGE_ROOT=.integration-data/snapshots
