{
  "$defs": {
    "coverage": {
      "additionalProperties": false,
      "properties": {
        "artifactRole": {
          "enum": [
            "TRADE_HISTORY",
            "POSITION_HISTORY"
          ]
        },
        "coverageCompleteness": {
          "const": "NOT_PROVEN"
        },
        "earliestObservedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixtureCompletenessScope": {
          "const": "SYNTHETIC_SCENARIO_ONLY"
        },
        "latestObservedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "rowCount": {
          "minimum": 0,
          "type": "integer"
        },
        "sourceTimezone": {
          "type": "string"
        },
        "timestampPrecision": {
          "const": "SECOND"
        },
        "venueExportCompletenessAsserted": {
          "const": false
        }
      },
      "required": [
        "artifactRole",
        "earliestObservedAt",
        "latestObservedAt",
        "rowCount",
        "sourceTimezone",
        "timestampPrecision",
        "coverageCompleteness",
        "fixtureCompletenessScope",
        "venueExportCompletenessAsserted"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "artifactCoverages": {
      "items": {
        "$ref": "#/$defs/coverage"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "expectedImportStatus": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "fixtureId": {
      "type": "string"
    },
    "fixtureSetVersion": {
      "const": 3
    },
    "schemaVersion": {
      "const": "3.0.0"
    },
    "versionMetadata": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "fixtureSetVersion",
    "fixtureId",
    "contextScenarioIds",
    "acceptanceScenarioIds",
    "sourceDialects",
    "versionMetadata",
    "artifacts",
    "artifactCoverages",
    "commonAnalyzableInterval",
    "expectedImportStatus",
    "expectedFailureCode",
    "expectedEpisodeCount",
    "manualVerification"
  ],
  "title": "Trading Review raw v3 fixture manifest",
  "type": "object"
}
